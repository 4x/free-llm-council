# Copy to .env in your working directory. Never commit your actual API key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional Gemini Developer API (https://googleapis.github.io/python-genai).
# Comma-separated model IDs, e.g. GEMINI_MODELS=gemini-3.6-flash,gemini-3.7-flash,gemini-3.8-flash
GEMINI_API_KEY=
GEMINI_MODELS=

# DEBUG / INFO / WARNING / ERROR / CRITICAL; logs go to stderr, synthesis to stdout.
LOG_LEVEL=INFO

# NONE / NO / NEITHER, DUCKDB, MARKDOWN, or BOTH (case-insensitive)
SAVE_PROMPT=DUCKDB
SAVE_INITIAL_ANSWERS=NO
SAVE_SYNTHESIS=NO
DUCKDB_PATH=council.duckdb
MARKDOWN_DIR=council-output
# Self-contained HTML reports written by --export-html (flag: --html-dir).
HTML_DIR=html-output

# Synthesis-only Markdown recipe: writes a single file directly under
# MARKDOWN_DIR as <slug>-synthesis-<YYYYMMDDThhmm>.md (no subfolder).
# SAVE_PROMPT=none
# SAVE_INITIAL_ANSWERS=none
# SAVE_SYNTHESIS=markdown

# random / round-robin / free-router / auto / most-intelligent / largest-context
# Or an exact OpenRouter model ID. 'auto' and paid IDs require JUDGE_SCOPE=all.
JUDGE=random
JUDGE_SCOPE=free

# UTF-8 .md/.txt system prompt; relative paths resolve from the working directory.
# Leave blank to use the built-in backup. A configured unreadable/empty file is an error.
JUDGE_PROMPT=prompts/judge.md

# Server-side web search for members and the judge (flag: --search-web).
# OpenRouter is sent the openrouter:web_search server tool (max_uses=3 per request);
# Gemini models use Google Search grounding instead. Searches are billed in addition
# to token costs, and are NOT covered by the free-model price cap, so a free model
# still incurs search charges: $0.007 per Exa search (free models have no native
# search), at most 3 searches per request = $0.021. Leave off unless you accept that cost.
SEARCH_WEB=0

# Reasoning effort for council members, the judge, and --improve:
# minimal / low / medium / high / max. Leave blank for each provider's default.
# OpenRouter receives reasoning.effort; Gemini receives thinking_level and has no 'max'
# level, so max is sent as high. Reasoning tokens count against MAX_TOKENS.
# They are billed as output tokens: free OpenRouter models cost $0 at any level, but
# GEMINI_MODELS must be free-tier models or higher levels cost more real money.
THINKING_LEVEL=

# Model IDs are configuration, never application constants.
# For JUDGE=free-router, set FREE_ROUTER_MODEL=openrouter/free.
# For JUDGE=auto, set AUTO_ROUTER_MODEL=openrouter/auto and JUDGE_SCOPE=all.
FREE_ROUTER_MODEL=
AUTO_ROUTER_MODEL=
# Recommended: exclude router entries from individual council/ranked judge selection.
ROUTER_MODELS=openrouter/free,openrouter/auto,openrouter/bodybuilder

# Comma-separated IDs to skip for both council members and judges.
# Recommended for plain-chat clients: thinkingmachines/inkling-small:free (harness-only).
EXCLUDED_MODELS=thinkingmachines/inkling-small:free

# Free-model limits are account-wide; 3.1s spacing targets <20 request starts/minute.
MAX_CONCURRENCY=3
REQUEST_INTERVAL=3.1
REQUEST_TIMEOUT=120
MAX_RETRIES=2
MAX_RETRY_WAIT=60
MAX_TOKENS=2048
