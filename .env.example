# Copy to .env in your working directory. Never commit your actual API key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# DEBUG / INFO / WARNING / ERROR / CRITICAL; logs go to stderr, synthesis to stdout.
LOG_LEVEL=INFO

# NONE / NO / NEITHER, DUCKDB, MARKDOWN, or BOTH (case-insensitive)
SAVE_PROMPT=DUCKDB
SAVE_INITIAL_ANSWERS=NO
SAVE_SYNTHESIS=NO
DUCKDB_PATH=council.duckdb
MARKDOWN_DIR=council-output

# random / round-robin / free-router / auto / most-intelligent / largest-context
# Or an exact OpenRouter model ID. 'auto' and paid IDs require JUDGE_SCOPE=all.
JUDGE=random
JUDGE_SCOPE=free

# Additional comma-separated model IDs to skip for both council members and judges.
# thinkingmachines/inkling-small:free is always skipped (known harness-only endpoint).
EXCLUDED_MODELS=

# Free-model limits are account-wide; 3.1s spacing targets <20 request starts/minute.
MAX_CONCURRENCY=3
REQUEST_INTERVAL=3.1
REQUEST_TIMEOUT=120
MAX_RETRIES=2
MAX_RETRY_WAIT=60
MAX_TOKENS=2048
